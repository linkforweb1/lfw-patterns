  "content": "<!-- wp:group {\"tagName\":\"section\",\"align\":\"full\",\"style\":{\"color\":{\"gradient\":\"linear-gradient(135deg,rgb(23,105,151) 66%,rgb(248,200,144) 66%)\"},\"spacing\":{\"padding\":{\"left\":\"4rem\",\"right\":\"4rem\",\"top\":\"4rem\",\"bottom\":\"4rem\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<section class=\"wp-block-group alignfull has-background\" style=\"background:linear-gradient(135deg,rgb(23,105,151) 66%,rgb(248,200,144) 66%);padding-top:4rem;padding-right:4rem;padding-bottom:4rem;padding-left:4rem\"><!-- wp:columns {\"verticalAlignment\":\"center\",\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns alignwide are-vertically-aligned-center\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"55%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:55%\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\"><!-- wp:heading {\"level\":1,\"style\":{\"typography\":{\"lineHeight\":\"1.1\",\"fontStyle\":\"normal\",\"fontWeight\":\"700\",\"textTransform\":\"uppercase\",\"fontSize\":\"50px\"},\"color\":{\"text\":\"#f8c890\"}}} -->\n<h1 class=\"wp-block-heading has-text-color\" style=\"color:#f8c890;font-size:50px;font-style:normal;font-weight:700;line-height:1.1;text-transform:uppercase\">Every Great Project Starts with the Right Domain</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#fbc892\"}},\"fontSize\":\"medium\"} -->\n<p class=\"has-text-color has-medium-font-size\" style=\"color:#fbc892\">A clear and memorable domain is the foundation of a strong brand. Domaintechnik offers a wide selection of domain extensions – from .at and .com to modern options like .shop or .blog.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"style\":{\"spacing\":{\"margin\":{\"top\":\"2rem\"}}},\"layout\":{\"type\":\"flex\",\"orientation\":\"horizontal\"}} -->\n<div class=\"wp-block-buttons\" style=\"margin-top:2rem\"><!-- wp:button {\"className\":\"is-style-fill\",\"style\":{\"border\":{\"radius\":\"100px\"},\"spacing\":{\"padding\":{\"left\":\"1.5rem\",\"right\":\"1.5rem\",\"top\":\"0.9rem\",\"bottom\":\"0.9rem\"}},\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"600\"},\"color\":{\"background\":\"#f8c890\",\"text\":\"#176997\"}}} -->\n<div class=\"wp-block-button is-style-fill\"><a class=\"wp-block-button__link has-text-color has-background wp-element-button\" style=\"border-radius:100px;color:#176997;background-color:#f8c890;padding-top:0.9rem;padding-right:1.5rem;padding-bottom:0.9rem;padding-left:1.5rem;font-style:normal;font-weight:600\">Check Domain</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\",\"style\":{\"border\":{\"radius\":\"50px\",\"width\":\"2px\"},\"spacing\":{\"padding\":{\"left\":\"2rem\",\"right\":\"2rem\",\"top\":\"0.9rem\",\"bottom\":\"0.9rem\"}},\"elements\":{\"link\":{\"color\":{\"text\":\"#f8c890\"}}},\"color\":{\"text\":\"#f8c890\"}}} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link has-text-color has-link-color wp-element-button\" style=\"border-width:2px;border-radius:50px;color:#f8c890;padding-top:0.9rem;padding-right:2rem;padding-bottom:0.9rem;padding-left:2rem\"><strong>Chi siamo</strong></a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"45%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:45%\"><!-- wp:image {\"aspectRatio\":\"3/4\",\"scale\":\"cover\",\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"is-style-default\",\"style\":{\"border\":{\"color\":\"#f8c890\",\"width\":\"15px\"}}} -->\n<figure class=\"wp-block-image size-large has-custom-border is-style-default\"><img src=\"https://images.pexels.com/photos/1330217/pexels-photo-1330217.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1260&amp;h=750&amp;dpr=2\" alt=\"\" class=\"has-border-color\" style=\"border-color:#f8c890;border-width:15px;aspect-ratio:3/4;object-fit:cover\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></section>\n<!-- /wp:group -->",
