yle\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"padding\":{\"right\":\"0\",\"left\":\"0\"},\"blockGap\":\"0\"}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-group alignwide is-style-default agl agl-fadeCSS agl-in-duration-300 agl-in-distance-1\" style=\"margin-top:0;margin-bottom:0;padding-right:0;padding-left:0\"><!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|70\",\"left\":\"0\"},\"padding\":{\"top\":\"0\",\"bottom\":\"0\",\"left\":\"0\",\"right\":\"0\"}}}} -->\n<div class=\"wp-block-columns alignwide\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"60%\",\"style\":{\"spacing\":{\"blockGap\":\"0\"}}} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:60%\"><!-- wp:group {\"style\":{\"dimensions\":{\"minHeight\":\"100%\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"center\",\"flexWrap\":\"nowrap\",\"verticalAlignment\":\"top\"}} -->\n<div class=\"wp-block-group\" style=\"min-height:100%\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\"><!-- wp:image {\"id\":570,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"style\":{\"border\":{\"radius\":{\"topLeft\":\"1rem\",\"topRight\":\"1rem\",\"bottomLeft\":\"1rem\",\"bottomRight\":\"1rem\"},\"color\":\"#ffffff47\",\"width\":\"1px\"}}} -->\n<figure class=\"wp-block-image size-full has-custom-border\"><img src=\"https://giuseppedorato.linkforweb.com/wp-content/uploads/2025/11/immagine-skill-5.webp\" alt=\"\" class=\"has-border-color wp-image-570\" style=\"border-color:#ffffff47;border-width:1px;border-top-left-radius:1rem;border-top-right-radius:1rem;border-bottom-left-radius:1rem;border-bottom-right-radius:1rem\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3,\"className\":\"tw-text-balance\",\"fontSize\":\"x-large\"} -->\n<h3 class=\"wp-block-heading tw-text-balance has-x-large-font-size\">Sviluppatore frontend con specializzazione per l'eCommerce</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"is-style-default\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"#ffffffb3\"}}},\"color\":{\"text\":\"#ffffffb3\"}},\"fontSize\":\"medium\"} -->\n<p class=\"is-style-default has-text-color has-link-color has-medium-font-size\" style=\"color:#ffffffb3\">Sono un web designer, sviluppatore e specialista eCommerce. Realizzo siti aziendali ed eCommerce su misura per PMI e privati, offrendo consulenza, assistenza e formazione. Grazie a strumenti come WordPress, Shopify e Wix, combino creatività e competenza tecnica per creare soluzioni efficaci e scalabili.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#ffffffb3\"},\"elements\":{\"link\":{\"color\":{\"text\":\"#ffffffb3\"}}}},\"fontSize\":\"medium\"} -->\n<p class=\"has-text-color has-link-color has-medium-font-size\" style=\"color:#ffffffb3\">Da oltre 10 anni aiuto aziende e imprenditori a trasformare le loro idee in soluzioni digitali di successo. La mia specializzazione? Creare esperienze online che vendono, che convertono e che lasciano un impressione duratura.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"className\":\"\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"#ffffffb3\"}}},\"color\":{\"text\":\"#ffffffb3\"}},\"fontSize\":\"medium\"} -->\n<p class=\"has-text-color has-link-color has-medium-font-size\" style=\"color:#ffffffb3\">Lavoro ogni giorno per restare al passo con le ultime tecnologie e best practices del settore, garantendo ai miei clienti soluzioni moderne, performanti e scalabili.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"top\",\"width\":\"40%