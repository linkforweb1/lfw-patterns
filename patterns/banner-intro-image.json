    "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t<!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\"}}}} -->\n\t<div class=\"wp-block-columns alignwide\">\n\t\t<!-- wp:column {\"width\":\"56%\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:56%\">\n\t\t\t<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\"} -->\n\t\t\t<figure class=\"wp-block-image size-full\">\n\t\t\t\t<img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%27%23cfcfcf%27%2F%3E%3C%2Fsvg%3E\" alt=\"Immagine di un fiore\" style=\"aspect-ratio:1;object-fit:cover\"/>\n\t\t\t</figure>\n\t\t\t<!-- /wp:image -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}}} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:heading -->\n\t\t\t<h2 class=\"wp-block-heading\">Nuovi arrivi</h2>\n\t\t\t<!-- /wp:heading -->\n\n\t\t\t<!-- wp:paragraph -->\n\t\t\t<p>Come i fiori che sbocciano in luoghi inaspettati, ogni storia si svela con bellezza e resilienza, riv