    "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"26rem\"}} -->\n\t<div class=\"wp-block-group alignwide\" style=\"padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t\t<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"verticalAlignment\":\"space-between\",\"justifyContent\":\"stretch\",\"flexWrap\":\"nowrap\"}} -->\n\t\t<div class=\"wp-block-group\">\n\t\t\t<!-- wp:group {\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"left\"}} -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t\t<!-- wp:heading {\"className\":\"is-style-text-annotation\"} -->\n\t\t\t\t<h2 class=\"wp-block-heading is-style-text-annotation\">Chi siamo</h2>\n\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t<!-- wp:paragraph {\"className\":\"is-style-text-subtitle\"} -->\n\t\t\t\t<p class=\"is-style-text-subtitle\">\n\t\t\t\t<strong>Fleurs</strong> è un&#039;attività di consegna e abbonamento di fiori. Con sede nell&#039;UE, la nostra missione non è solo la fornitura di splendide composizioni floreali, ma anche la promozione della conoscenza e dell&#039;entusiasmo per il meraviglioso dono della natura: i fiori.\t\t\t\t</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\n\t\t\t<!-- wp:image {\"aspectRatio\":\"16/9\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t\t<figure class=\"wp-block-image size-full\"><img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%27%23cfcfcf%27%2F%3E%3C%2Fsvg%3E\" alt=\"Foto di un fiore rosso in primo piano.\" style=\"aspect-ratio:16/9;object-fit:cover\"/></figure>\n\t\t\t<!-- /wp:image -->\n\t\t</div>\n\t\t<!-- /wp:group -->\n\n\t\t<!-- wp:image {\"aspectRatio\":\"3/4\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t<figure class=\"wp-block-image size-full\"><img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%27%23cfcfcf%27%2F%3E%3C%2Fsvg%3E\" alt=\"Fotografia in bianco e nero, primo piano di un fiore.\" style=\"aspect-ratio:3/4;object-fit:cover\"/></figure>\n\t\t<!-- /wp:image -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n"
