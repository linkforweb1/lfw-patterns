- wp:heading {\"style\":{\"typography\":{\"fontSize\":\"var:preset|font-size|xx-large\"}}} -->\r\n<h2 class=\"wp-block-heading\" style=\"font-size:var(--wp--preset--font-size--xx-large)\"><strong>A day in nature</strong></h2>\r\n<!-- /wp:heading -->\r\n\r\n<!-- wp:paragraph {\"style\":{\"typography\":{\"lineHeight\":\"1.7\"}},\"fontSize\":\"medium\"} -->\r\n<p class=\"has-medium-font-size\" style=\"line-height:1.7\">The word&nbsp;<em>nature</em>&nbsp;is borrowed from the&nbsp;<a href=\"https://en.wikipedia.org/wiki/Old_French\">Old French</a>&nbsp;<em>nature</em>&nbsp;and is derived from the&nbsp;<a href=\"https://en.wikipedia.org/wiki/Latin\">Latin</a>&nbsp;word&nbsp;<em>natura</em>, or \"essential qualities, innate disposition\", and in ancient times, literally meant \"birth\".</p>\r\n<!-- /wp:paragraph -->\r\n\r\n<!-- wp:buttons -->\r\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"var:preset|color|contrast\"}}} -->\r\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-background wp-element-button\" style=\"background-color:var(--wp--preset--color--contrast)\">Read More</a></div>\r\n<!-- /wp:button --></div>\r\n<!-- /wp:buttons --></div>\r\n<!-- /wp:column --></div>\r\n<!-- /wp:columns --></div>\r\n<!-- /wp:group --></div></div>\r\n<!-- /wp:cover -->"
