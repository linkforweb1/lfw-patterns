  "content": "<!-- wp:group {\"metadata\":{\"categories\":[\"call-to-action\"],\"patternName\":\"twentytwentyfive/cta-centered-heading\",\"name\":\"Hero aree terapeutiche\"},\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"right\":\"0\",\"left\":\"0\",\"top\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}},\"dimensions\":{\"minHeight\":\"0vh\"}},\"layout\":{\"type\":\"constrained\",\"justifyContent\":\"left\"}} -->\n<div class=\"wp-block-group alignwide\" style=\"min-height:0vh;margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--60);padding-right:0;padding-bottom:var(--wp--preset--spacing--60);padding-left:0\"><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\",\"padding\":{\"top\":\"0\",\"bottom\":\"0\",\"left\":\"0\",\"right\":\"0\"}}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignwide\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"left\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"backgroundColor\":\"accent-3\",\"textColor\":\"accent-1\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|accent-1\"}}},\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"500\"},\"spacing\":{\"padding\":{\"left\":\"1rem\",\"right\":\"1rem\",\"top\":\"0.38rem\",\"bottom\":\"0.38rem\"}}},\"fontSize\":\"small\"} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-accent-1-color has-accent-3-background-color has-text-color has-background has-link-color has-small-font-size has-custom-font-size wp-element-button\" style=\"padding-top:0.38rem;padding-right:1rem;padding-bottom:0.38rem;padding-left:1rem;font-style:normal;font-weight:500\">Le Nostre Competenze</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:heading {\"textAlign\":\"left\",\"style\":{\"spacing\":{\"margin\":{\"right\":\"0\",\"left\":\"0\"},\"padding\":{\"right\":\"0\",\"left\":\"0\"}},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|accent-1\"}}},\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"600\"}},\"textColor\":\"accent-1\",\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-text-align-left has-accent-1-color has-text-color has-link-color has-xx-large-font-size\" style=\"margin-right:0;margin-left:0;padding-right:0;padding-left:0;font-style:normal;font-weight:600\">Aree Terapeutiche</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"left\",\"className\":\"tw-text-balance\",\"style\":{\"typography\":{\"lineHeight\":\"1.7\"},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|accent-4\"}}}},\"textColor\":\"accent-4\",\"fontSize\":\"medium\"} -->\n<p class=\"has-text-align-left tw-text-balance has-accent-4-color has-text-color has-link-color has-medium-font-size\" style=\"line-height:1.7\">Operiamo in 8 aree terapeutiche fondamentali, sviluppando soluzioni specifiche per ogni esigenza di salute e benessere, con un approccio scientifico e attento alle esigenze dei pazienti.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->",
