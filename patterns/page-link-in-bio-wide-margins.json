-radius:150px;object-fit:cover\"/></figure>\n\t\t\t<!-- /wp:image -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:group {\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t\t<!-- wp:heading {\"textAlign\":\"left\"} -->\n\t\t\t\t<h2 class=\"wp-block-heading has-text-align-left\">Nora Winslow Keene</h2>\n\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t<p>Sono Nora, procuratore impegnata nell&#039;interesse pubblico a Denver. Sono laureata alla Stanford University.</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\n\t\t\t\t<!-- wp:social-links {\"iconColor\":\"currentColor\",\"iconColorValue\":\"currentColor\",\"className\":\"is-style-logos-only\"} -->\n\t\t\t\t<ul class=\"wp-block-social-links has-icon-color is-style-logos-only\">\n\t\t\t\t\t<!-- wp:social-link {\"url\":\"#\",\"service\":\"x\"} /-->\n\n\t\t\t\t\t<!-- wp:social-link {\"url\":\"#\",\"service\":\"instagram\"} /-->\n\n\t\t\t\t\t<!-- wp:social-link {\"url\":\"#\",\"service\":\"whatsapp\"} /-->\n\t\t\t\t</ul>\n\t\t\t\t<!-- /wp:social-links -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n"
