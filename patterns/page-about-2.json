    "content": "<!-- wp:cover {\"url\":\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%27%23cfcfcf%27%2F%3E%3C%2Fsvg%3E\",\"dimRatio\":50,\"isUserOverlayColor\":true,\"minHeight\":\"4.375rem\",\"minHeightUnit\":\"vh\",\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-cover alignfull\" style=\"min-height:70vh\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%27%23cfcfcf%27%2F%3E%3C%2Fsvg%3E\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"textAlign\":\"center\",\"level\":1} --><h1 class=\"wp-block-heading has-text-align-center\">Scrivi un titolo di pagina che attiri l&#039;attenzione del tuo pubblico</h1><!-- /wp:heading --></div></div><!-- /wp:cover --><!-- wp:group {\"metadata\":{\"name\":\"3 colonne\"},\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull has-base-background-color has-background\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center\">Scrivi un titolo</h2><!-- /wp:heading --><!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"lineHeight\":\"1.35\"},\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|50\"}}},\"fontSize\":\"large\"} --><p class=\"has-text-align-center has-large-font-size\" style=\"margin-bottom:var(--wp--preset--spacing--50);line-height:1.35\">Lorem ipsum dolor sit amet, commodo erat adipiscing elit. Sed do eiusmod ut tempor incididunt ut labore et dolore.</p><!-- /wp:paragraph --><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"grid\",\"columnCount\":3,\"minimumColumnWidth\":\"300px\"}} --><div class=\"wp-block-group alignwide\"><!-- wp:group {\"style\":{\"border\":{\"top\":{\"width\":\"0.0625rem\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\"}}},\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\" style=\"border-top-width:0.0625rem;padding-top:var(--wp--preset--spacing--40)\"><!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} --><h3 class=\"wp-block-heading has-large-font-size\">01. Primo elemento</h3><!-- /wp:heading --><!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"1rem\"}}}} --><p style=\"margin-top:1rem\">Lorem ipsum dolor sit amet, commodo erat adipiscing elit. Sed do eiusmod ut tempor incididunt ut labore et dolore.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"style\":{\"border\":{\"top\":{\"width\":\"0.0625rem\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\"}}},\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\" style=\"border-top-width:0.0625rem;padding-top:var(--wp--preset--spacing--40)\"><!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} --><h3 class=\"wp-block-heading has-large-font-size\">02. Secondo elemento</h3><!-- /wp:heading --><!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"1rem\"}}}} --><p style=\"margin-top:1rem\">Integer enim risus, suscipit eu iaculis sed, ullamcorper at metus. Venenatis nec convallis magna, eu congue velit.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"style\":{\"border\":{\"top\":{\"width\":\"0.0625rem\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\"}}},\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\" style=\"border-top-width:0.0625rem;padding-top:var(--wp--preset--spacing--40)\"><!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} --><h3 class=\"wp-block-heading has-large-font-size\">03. Terzo elemento</h3><!-- /wp:heading --><!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"1rem\"}}}} --><p style=\"margin-top:1rem\">Aliquam tempus mi nulla porta luctus. Sed non neque at lectus bibendum blandit. Morbi fringilla sapien libero.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"style\":{\"border\":{\"top\":{\"width\":\"0.0625rem\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\"}}},\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\" style=\"border-top-width:0.0625rem;padding-top:var(--wp--preset--spacing--40)\"><!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} --><h3 class=\"wp-block-heading has-large-font-size\">04. Quarto elemento</h3><!-- /wp:heading --><!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"1rem\"}}}} --><p style=\"margin-top:1rem\">Duis enim elit, porttitor id feugiat at, blandit at erat. Proin varius libero sit amet tortor volutpat diam laoreet.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"style\":{\"border\":{\"top\":{\"width\":\"0.0625rem\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\"}}},\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\" style=\"border-top-width:0.0625rem;padding-top:var(--wp--preset--spacing--40)\"><!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} --><h3 class=\"wp-block-heading has-large-font-size\">05. Quinto elemento</h3><!-- /wp:heading --><!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"1rem\"}}}} --><p style=\"margin-top:1rem\">Fusce sed magna eu ligula commodo hendrerit fringilla ac purus. Integer sagittis efficitur rhoncus justo.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"style\":{\"border\":{\"top\":{\"width\":\"0.0625rem\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\"}}},\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\" style=\"border-top-width:0.0625rem;padding-top:var(--wp--preset--spacing--40)\"><!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} --><h3 class=\"wp-block-heading has-large-font-size\">06. Sesto elemento</h3><!-- /wp:heading --><!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"1rem\"}}}} --><p style=\"margin-top:1rem\">Mauris dui tellus mollis quis varius, sit amet ultrices in leo. Cras et purus sit amet velit congue convallis nec id diam.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"metadata\":{\"name\":\"Team\"},\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"}}},\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center\">Il nostro team</h2><!-- /wp:heading --><!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"lineHeight\":\"1.35\"},\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|50\"}}},\"fontSize\":\"large\"} --><p class=\"has-text-align-center has-large-font-size\" style=\"margin-bottom:var(--wp--preset--spacing--50);line-height:1.35\">Commodo erat adipiscing elit. Sed do eiusmod ut tempor incididunt ut labore et dolore. Integer enim risus suscipit eu iaculis sed.</p><!-- /wp:paragraph --><!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"grid\",\"columnCount\":3,\"minimumColumnWidth\":\"300px\"}} --><div class=\"wp-block-group alignwide\"><!-- wp:group {\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"1rem\"}}},\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\" style=\"margin-bottom:1rem\"><!-- wp:image --><figure class=\"wp-block-image\"><img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%27%23cfcfcf%27%2F%3E%3C%2Fsvg%3E\" alt=\"\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} --><h3 class=\"wp-block-heading has-large-font-size\">Julie Miller</h3><!-- /wp:heading --><!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}},\"textColor\":\"contrast\",\"fontSize\":\"small\"} --><p class=\"has-contrast-color has-text-color has-small-font-size\" style=\"margin-top:0.25rem\">Fondatore</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"1rem\"}}},\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\" style=\"margin-bottom:1rem\"><!-- wp:image --><figure class=\"wp-block-image\"><img src=\"data:image/svg+xml,%3Csvg%20xmlns%3