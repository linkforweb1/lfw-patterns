    "title": "FAQ section with expandable answers",
    "slug": "lfw/faq-section-with-expandable-answers",
    "content": "<!-- wp:group {\"style\":{\"color\":{\"background\":\"#f5f4f1\"},\"spacing\":{\"padding\":{\"top\":\"5rem\",\"bottom\":\"5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"760px\"}} -->\r\n<div class=\"wp-block-group has-background\" style=\"background-color:#f5f4f1;padding-top:5rem;padding-right:1.5rem;padding-bottom:5rem;padding-left:1.5rem\"><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#6b6a65\"},\"typography\":{\"textTransform\":\"uppercase\",\"letterSpacing\":\"2px\",\"fontSize\":\"0.75rem\",\"textAlign\":\"center\"},\"spacing\":{\"margin\":{\"bottom\":\"0.5rem\"}}}} -->\r\n<p class=\"has-text-align-center has-text-color\" style=\"color:#6b6a65;margin-bottom:0.5rem;font-size:0.75rem;letter-spacing:2px;text-transform:uppercase\">assistenza</p>\r\n<!-- /wp:paragraph -->\r\n\r\n<!-- wp:heading {\"style\":{\"color\":{\"text\":\"#1a1a18\"},\"typography\":{\"fontSize\":\"2.5rem\",\"lineHeight\":\"1.2\",\"textAlign\":\"center\"},\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0.75rem\"}}}} -->\r\n<h2 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#1a1a18;margin-top:0;margin-bottom:0.75rem;font-size:2.5rem;line-height:1.2\">Domande frequenti</h2>\r\n<!-- /wp:heading -->\r\n\r\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#57564f\"},\"spacing\":{\"margin\":{\"bottom\":\"2.5rem\"}},\"typography\":{\"textAlign\":\"center\"}}} -->\r\n<p class=\"has-text-align-center has-text-color\" style=\"color:#57564f;margin-bottom:2.5rem\">Everything you need to know before getting started. Select a question to reveal the answer.</p>\r\n<!-- /wp:paragraph -->\r\n\r\n<!-- wp:accordion {\"autoclose\":true,\"style\":{\"spacing\":{\"blockGap\":\"0.75rem\"}}} -->\r\n<div role=\"group\" class=\"wp-block-accordion\"><!-- wp:accordion-item {\"openByDefault\":true,\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#1a1a18\"},\"border\":{\"radius\":\"10px\",\"width\":\"1px\",\"color\":\"#e3e1db\"},\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"bottom\":\"0.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}}}} -->\r\n<div class=\"wp-block-accordion-item is-open has-border-color has-text-color has-background\" style=\"border-color:#e3e1db;border-width:1px;border-radius:10px;color:#1a1a18;background-color:#ffffff;padding-top:0.5rem;padding-right:1.5rem;padding-bottom:0.5rem;padding-left:1.5rem\"><!-- wp:accordion-heading {\"level\":3,\"fontSize\":\"medium\"} -->\r\n<h3 class=\"wp-block-accordion-heading has-icon has-icon-right has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\"><strong>How long does shipping take?</strong></span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\r\n<!-- /wp:accordion-heading -->\r\n\r\n<!-- wp:accordion-panel -->\r\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#57564f\"},\"spacing\":{\"margin\":{\"bottom\":\"0\"}}}} -->\r\n<p class=\"has-text-color\" style=\"color:#57564f;margin-bottom:0\">Orders ship within one business day and arrive in three to five days.</p>\r\n<!-- /wp:paragraph --></div>\r\n<!-- /wp:accordion-panel --></div>\r\n<!-- /wp:accordion-item -->\r\n\r\n<!-- wp:accordion-item {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#1a1a18\"},\"border\":{\"radius\":\"10px\",\"width\":\"1px\",\"color\":\"#e3e1db\"},\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"bottom\":\"0.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}}}} -->\r\n<div class=\"wp-block-accordion-item has-border-color has-text-color has-background\" style=\"border-color:#e3e1db;border-width:1px;border-radius:10px;color:#1a1a18;background-color:#ffffff;padding-top:0.5rem;padding-right:1.5rem;padding-bottom:0.5rem;padding-left:1.5rem\"><!-- wp:accordion-heading {\"level\":3,\"fontSize\":\"medium\"} -->\r\n<h3 class=\"wp-block-accordion-heading has-icon has-icon-right has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\"><strong>Can I change or cancel my order?</strong></span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\r\n<!-- /wp:accordion-heading -->\r\n\r\n<!-- wp:accordion-panel -->\r\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#57564f\"},\"spacing\":{\"margin\":{\"bottom\":\"0\"}}}} -->\r\n<p class=\"has-text-color\" style=\"color:#57564f;margin-bottom:0\">Yes, until it ships. Reply to your confirmation email and we will update it.</p>\r\n<!-- /wp:paragraph --></div>\r\n<!-- /wp:accordion-panel --></div>\r\n<!-- /wp:accordion-item -->\r\n\r\n<!-- wp:accordion-item {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#1a1a18\"},\"border\":{\"radius\":\"10px\",\"width\":\"1px\",\"color\":\"#e3e1db\"},\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"bottom\":\"0.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}}}} -->\r\n<div class=\"wp-block-accordion-item has-border-color has-text-color has-background\" style=\"border-color:#e3e1db;border-width:1px;border-radius:10px;color:#1a1a18;background-color:#ffffff;padding-top:0.5rem;padding-right:1.5rem;padding-bottom:0.5rem;padding-left:1.5rem\"><!-- wp:accordion-heading {\"level\":3,\"fontSize\":\"medium\"} -->\r\n<h3 class=\"wp-block-accordion-heading has-icon has-icon-right has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\"><strong>What is your return policy?</strong></span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\r\n<!-- /wp:accordion-heading -->\r\n\r\n<!-- wp:accordion-panel -->\r\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#57564f\"},\"spacing\":{\"margin\":{\"bottom\":\"0\"}}}} -->\r\n<p class=\"has-text-color\" style=\"color:#57564f;margin-bottom:0\">Return anything unused within thirty days for a full refund.</p>\r\n<!-- /wp:paragraph --></div>\r\n<!-- /wp:accordion-panel --></div>\r\n<!-- /wp:accordion-item -->\r\n\r\n<!-- wp:accordion-item {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#1a1a18\"},\"border\":{\"radius\":\"10px\",\"width\":\"1px\",\"color\":\"#e3e1db\"},\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"bottom\":\"0.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}}}} -->\r\n<div class=\"wp-block-accordion-item has-border-color has-text-color has-background\" style=\"border-color:#e3e1db;border-width:1px;border-radius:10px;color:#1a1a18;background-color:#ffffff;padding-top:0.5rem;padding-right:1.5rem;padding-bottom:0.5rem;padding-left:1.5rem\"><!-- wp:accordion-heading {\"level\":3,\"fontSize\":\"medium\"} -->\r\n<h3 class=\"wp-block-accordion-heading has-icon has-icon-right has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\"><strong>Do you ship internationally?</strong></span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\r\n<!-- /wp:accordion-heading -->\r\n\r\n<!-- wp:accordion-panel -->\r\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#57564f\"},\"spacing\":{\"margin\":{\"bottom\":\"0\"}}}} -->\r\n<p class=\"has-text-color\" style=\"color:#57564f;margin-bottom:0\">Yes. Duties and import taxes are calculated at checkout.</p>\r\n<!-- /wp:paragraph --></div>\r\n<!-- /wp:accordion-panel --></div>\r\n<!-- /wp:accordion-item -->\r\n\r\n<!-- wp:accordion-item {\"style\":{\"color\":{\"background\":\"#ffffff\",\"text\":\"#1a1a18\"},\"border\":{\"radius\":\"10px\",\"width\":\"1px\",\"color\":\"#e3e1db\"},\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"bottom\":\"0.5rem\",\"left\":\"1.5rem\",\"right\":\"1.5rem\"}}}} -->\r\n<div class=\"wp-block-accordion-item has-border-color has-text-color has-background\" style=\"border-color:#e3e1db;border-width:1px;border-radius:10px;color:#1a1a18;background-color:#ffffff;padding-top:0.5rem;padding-right:1.5rem;padding-bottom:0.5rem;padding-left:1.5rem\"><!-- wp:accordion-heading {\"level\":3,\"fontSize\":\"medium\"} -->\r\n<h3 class=\"wp-block-accordion-heading has-icon has-icon-right has-medium-font-size\"><button type=\"button\" class=\"wp-block-accordion-heading__toggle\"><span class=\"wp-block-accordion-heading__toggle-title\"><strong>How do I contact support?</strong></span><span class=\"wp-block-accordion-heading__toggle-icon\" aria-hidden=\"true\">+</span></button></h3>\r\n<!-- /wp:accordion-heading -->\r\n\r\n<!-- wp:accordion-panel -->\r\n<div role=\"region\" class=\"wp-block-accordion-panel\"><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#57564f\"},\"spacing\":{\"margin\":{\"bottom\":\"0\"}}}} -->\r\n<p class=\"has-text-color\" style=\"color:#57564f;margin-bottom:0\">Email our team and we will reply within one business day.</p>\r\n<!-- /wp:paragraph --></div>\r\n<!-- /wp:accordion-panel --></div>\r\n<!-- /wp:accordion-item --></div>\r\n<!-- /wp:accordion -->\r\n\r\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#57564f\"},\"spacing\":{\"margin\":{\"top\":\"2.5rem\",\"bottom\":\"1rem\"}},\"typography\":{\"textAlign\":\"center\"}}} -->\r\n<p class=\"has-text-align-center has-text-color\" style=\"color:#57564f;margin-top:2.5rem;margin-bottom:1rem\">Still have a question?</p>\r\n<!-- /wp:paragraph -->\r\n\r\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\r\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#1a1a18\",\"text\":\"#ffffff\"},\"border\":{\"radius\":\"6px\"},\"spacing\":{\"padding\":{\"top\":\"0.8rem\",\"bottom\":\"0.8rem\",\"left\":\"2rem\",\"right\":\"2rem\"}}}} -->\r\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background wp-element-button\" style=\"border-radius:6px;color:#ffffff;background-color:#1a1a18;padding-top:0.8rem;padding-right:2rem;padding-bottom:0.8rem;padding-left:2rem\">Contact our team</a></div>\r\n<!-- /wp:button --></div>\r\n<!-- /wp:buttons --></div>\r\n<!-- /wp:group -->"
}
