    "content": "\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t<!-- wp:columns {\"verticalAlignment\":null,\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|70\"}}}} -->\n\t<div class=\"wp-block-columns alignwide\">\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"\"} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:heading {\"className\":\"wp-block-heading\",\"fontSize\":\"xx-large\"} -->\n\t\t\t<h2 class=\"wp-block-heading has-xx-large-font-size\">A proposito del libro</h2>\n\t\t\t<!-- /wp:heading -->\n\n\t\t\t<!-- wp:paragraph {\"fontSize\":\"medium\"} -->\n\t\t\t<p class=\"has-medium-font-size\">This exquisite compilation showcases a diverse array of photographs that capture the essence of different eras and cultures, reflecting the unique styles and perspectives of each artist. Fleckenstein’s evocative imagery, Strand’s groundbreaking modernist approach, and Kōno’s meticulous documentation of Japanese life come together in a harmonious blend that celebrates the art of photography. Each image in “The Stories Book” is accompanied by insightful commentary, providing historical context and revealing the stories behind the photographs. This collection is not only a visual feast but also a tribute to the power of photography to preserve and narrate the multifaceted experiences of humanity.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"\",\"layout\":{\"type\":\"default\"}} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t\t<figure class=\"wp-block-image size-full\"><img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Ctext%20x%3D%27600%27%20y%3D%27432%27%20font-family%3D%27-apple-system%2CSegoe%20UI%2CRoboto%2CHelvetica%2CArial%2Csans-serif%27%20font-size%3D%2744%27%20fill%3D%27%238a8a8a%27%20text-anchor%3D%27middle%27%3Esegnaposto%20immagine%3C%2Ftext%3E%3C%2Fsvg%3E\" alt=\"Immagine di un libro\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n\t\t\t<!-- /wp:image -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n"
