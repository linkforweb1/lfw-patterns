    "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-section-1\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|80\",\"bottom\":\"var:preset|spacing|80\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull is-style-section-1\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--80);padding-bottom:var(--wp--preset--spacing--80)\">\n\t<!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|80\",\"left\":\"var:preset|spacing|80\"}}}} -->\n\t<div class=\"wp-block-columns alignwide\">\n\t\t<!-- wp:column {\"width\":\"45%\",\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|50\"}}}} -->\n\t\t<div class=\"wp-block-column\" style=\"padding-right:var(--wp--preset--spacing--50);flex-basis:45%\">\n\t\t\t<!-- wp:image {\"sizeSlug\":\"full\"} -->\n\t\t\t<figure class=\"wp-block-image size-full\"><img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Ctext%20x%3D%27600%27%20y%3D%27432%27%20font-family%3D%27-apple-system%2CSegoe%20UI%2CRoboto%2CHelvetica%2CArial%2Csans-serif%27%20font-size%3D%2744%27%20fill%3D%27%238a8a8a%27%20text-anchor%3D%27middle%27%3Esegnaposto%20immagine%3C%2Ftext%3E%3C%2Fsvg%3E\" alt=\"Foto di un fiore rosso in primo piano.\"/></figure>\n\t\t\t<!-- /wp:image -->\n\t\t\t<!-- wp:group {\"style\":{\"spacing\":{\"margin\":{\"top\":\"-12vw\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n\t\t\t<div class=\"wp-block-group\" style=\"margin-top:-12vw\">\n\t\t\t\t<!-- wp:image {\"width\":\"12.625rem\",\"sizeSlug\":\"full\",\"align\":\"right\",\"className\":\"is-resized\",\"style\":{\"spacing\":{\"margin\":{\"right\":\"-5vw\",\"left\":\"-5vw\"}}}} -->\n\t\t\t\t<figure class=\"wp-block-image alignright size-full is-resized\" style=\"margin-right:-5vw;margin-left:-5vw\"><img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Ctext%20x%3D%27600%27%20y%3D%27432%27%20font-family%3D%27-apple-system%2CSegoe%20UI%2CRoboto%2CHelvetica%2CArial%2Csans-serif%27%20font-size%3D%2744%27%20fill%3D%27%238a8a8a%27%20text-anchor%3D%27middle%27%3Esegnaposto%20immagine%3C%2Ftext%3E%3C%2Fsvg%3E\" alt=\"Fotografia in bianco e nero, primo piano di un fiore.\" style=\"width:12.625rem\"/></figure>\n\t\t\t\t<!-- /wp:image -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"50%\",\"style\":{\"spacing\":{\"padding\":{\"left\":\"0\",\"right\":\"0\"}}}} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\" style=\"padding-right:0;padding-left:0;flex-basis:50%\">\n\t\t\t<!-- wp:group {\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t\t<!-- wp:heading {\"className\":\"is-style-text-annotation\"} -->\n\t\t\t\t<h2 class=\"wp-block-heading is-style-text-annotation\">Chi siamo</h2>\n\t\t\t\t<!-- /wp:heading -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\n\t\t\t<!-- wp:paragraph {\"className\":\"is-style-text-subtitle\"} -->\n\t\t\t<p class=\"is-style-text-subtitle\">\n\t\t\t<strong>Fleurs</strong> è un&#039;attività di consegna e abbonamento di fiori. Con sede nell&#039;UE, la nostra missione non è solo la fornitura di splendide composizioni floreali, ma anche la promozione della conoscenza e dell&#039;entusiasmo per il meraviglioso dono della natura: i fiori.\t\t\t</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n"
}
