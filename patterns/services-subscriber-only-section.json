    "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\",\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\">\n\t<!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|70\",\"left\":\"var:preset|spacing|70\"}}}} -->\n\t<div class=\"wp-block-columns alignwide\">\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n\t\t\t<h2 class=\"wp-block-heading has-xx-large-font-size\">Abbonati per ottenere l&#039;accesso illimitato</h2>\n\t\t\t<!-- /wp:heading -->\n\n\t\t\t<!-- wp:list {\"className\":\"is-style-checkmark-list\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\"},\"padding\":{\"left\":\"var:preset|spacing|30\"}}}} -->\n\t\t\t<ul style=\"margin-top:var(--wp--preset--spacing--40);margin-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--30)\" class=\"wp-block-list is-style-checkmark-list\">\n\t\t\t\t<!-- wp:list-item {\"fontSize\":\"medium\"} -->\n\t\t\t\t<li class=\"has-medium-font-size\">Ottieni l&#039;accesso ai nostri articoli a pagamento e alla newsletter settimanale.</li>\n\t\t\t\t<!-- /wp:list-item -->\n\n\t\t\t\t<!-- wp:list-item {\"fontSize\":\"medium\"} -->\n\t\t\t\t<li class=\"has-medium-font-size\">Partecipa ai nostri eventi IRL.</li>\n\t\t\t\t<!-- /wp:list-item -->\n\n\t\t\t\t<!-- wp:list-item {\"fontSize\":\"medium\"} -->\n\t\t\t\t<li class=\"has-medium-font-size\">Ottieni una shopper in omaggio.</li>\n\t\t\t\t<!-- /wp:list-item -->\n\n\t\t\t\t<!-- wp:list-item {\"fontSize\":\"medium\"} -->\n\t\t\t\t<li class=\"has-medium-font-size\">Un&#039;elegante aggiunta alla collezione di decorazioni per la casa.</li>\n\t\t\t\t<!-- /wp:list-item -->\n\n\t\t\t\t<!-- wp:list-item {\"fontSize\":\"medium\"} -->\n\t\t\t\t<li class=\"has-medium-font-size\">Iscriviti ai nostri forum.</li>\n\t\t\t\t<!-- /wp:list-item -->\n\t\t\t</ul>\n\t\t\t<!-- /wp:list -->\n\n\t\t\t<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"left\",\"flexWrap\":\"nowrap\"}} -->\n\t\t\t<div class=\"wp-block-buttons\">\n\t\t\t\t<!-- wp:button {\"className\":\"is-style-fill\"} -->\n\t\t\t\t<div class=\"wp-block-button is-style-fill\"><a class=\"wp-block-button__link wp-element-button\">Abbonati</a></div>\n\t\t\t\t<!-- /wp:button -->\n\n\t\t\t\t<!-- wp:button {\"className\":\"is-style-outline\"} -->\n\t\t\t\t<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\">Visualizza i piani</a></div>\n\t\t\t\t<!-- /wp:button -->\n\t\t\t</div>\n\t\t\t<!-- /wp:buttons -->\n\n\t\t\t<!-- wp:paragraph {\"fontSize\":\"small\"} -->\n\t\t\t<p class=\"has-small-font-size\">Annulla o metti in pausa in qualsiasi momento.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t\t<figure class=\"wp-block-image size-full\"><img src=\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271200%27%20height%3D%27800%27%20viewBox%3D%270%200%201200%20800%27%20preserveAspectRatio%3D%27xMidYMid%20slice%27%3E%3Crect%20width%3D%271200%27%20height%3D%27800%27%20fill%3D%27%23e5e5e5%27%2F%3E%3Ccircle%20cx%3D%27330%27%20cy%3D%27262%27%20r%3D%2796%27%20fill%3D%27%23cfcfcf%27%2F%3E%3Cpath%20d%3D%27M110%20704%20L430%20384%20L642%20596%20L832%20430%20L1094%20700%20V704%20Z%27%20fill%3D%